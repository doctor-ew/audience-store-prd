# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# MARTA API Key
MARTA_API_KEY=

# Database URL for local development (Prisma with SQLite)
DATABASE_URL="file:./dev.db"

# Firebase Admin SDK credentials (for production on Vercel)
# These are not needed for local development if you are using the SQLite setup.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stadium Location (exposed to client)
NEXT_PUBLIC_STADIUM_NAME="Mercedes-Benz Stadium"
NEXT_PUBLIC_STADIUM_LAT="33.754542"
NEXT_PUBLIC_STADIUM_LNG="-84.402492"

